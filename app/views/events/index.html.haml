.app-content
  .content-wrapper
    .container
      .d-flex.align-items-center.mb-3
        %h4.mb-0 Events
        .ms-auto
        - if current_user.role == "admin"
          = link_to new_event_path, class: "btn btn-primary btn-sm d-flex align-items-center gap-1" do
            %i.material-icons add
            Add Event
      .row.g-3
        - @events.each do |event|
          .col-12.col-md-6.col-lg-4
            = link_to event_path(event), class: "text-decoration-none text-dark" do
              .card.shadow-sm.h-100.border-1.border-primary.shadow-primary
                .card-body

                  / Header
                  .d-flex.justify-content-between.align-items-start.mb-2
                    %h5.card-title.mb-0= event.name

                    - if event.event_date.present?
                      - status = event.event_date < Date.today ? "Past" : "Upcoming"
                      %span.badge{class: status == "Upcoming" ? "bg-success" : "bg-secondary"}
                        = status

                  / Date
                  .text-muted.small.mb-2
                    %i.material-icons.me-1 schedule
                    = event.event_date

                  / Location
                  .text-muted.small.mb-2
                    %i.material-icons.me-1 location_on
                    = event.location

                  / Type
                  .mb-2
                    %span.badge.bg-primary.text-light
                      = event.event_type

                  / Description
                  %p.small.text-muted.mb-3
                    = truncate(event.description, length: 120)