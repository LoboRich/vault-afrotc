.container.py-5
  .row.justify-content-center
    .col-md-6
      .card.shadow
        .card-body.text-center
          // Profile Image on top
          - if resource.photo.attached?
            = image_tag resource.photo.variant(resize_to_limit: [150, 150]).processed,
              class: "rounded-circle border mb-3",
              style: "width: 150px; height: 150px; object-fit: cover;"
          - else
            = image_tag "default-avatar.png",
              class: "rounded-circle border mb-3",
              style: "width: 150px; height: 150px; object-fit: cover;"

          %h3.mb-3= resource.email
          %p.text-muted Update your account information

          = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, multipart: true, class: "needs-validation text-start" }) do |f|
            - if resource.errors.any?
              #error_explanation
                %h4.text-danger.mb-3= "#{pluralize(resource.errors.count, 'error')} prohibited this user from being saved:"
                %ul
                  - resource.errors.full_messages.each do |msg|
                    %li= msg

            .row
              // Email
              .form-group.mb-3.col-md-6
                = f.label :email, "Email Address", class: "form-label"
                = f.email_field :email, class: "form-control", required: true
              // Current Password
              .form-group.mb-3.col-md-6
                = f.label :current_password, "Current Password", class: "form-label"
                = f.password_field :current_password, autocomplete: "off", class: "form-control", required: true
                %small.text-muted Required to update your account
            .row
              // Password
              .form-group.mb-3.col-md-6
                = f.label :password, "New Password", class: "form-label"
                = f.password_field :password, autocomplete: "off", class: "form-control"
                %small.text-muted Leave blank if you don’t want to change your password

              // Password Confirmation
              .form-group.mb-3.col-md-6
                = f.label :password_confirmation, "Confirm Password", class: "form-label"
                = f.password_field :password_confirmation, autocomplete: "off", class: "form-control"

            // Profile Photo Upload
            .form-group.mb-3
              = f.label :photo, "Change Profile Photo", class: "form-label"
              = f.file_field :photo, accept: "image/jpeg,image/png", class: "form-control"
              %small.text-muted Only JPG or PNG, max 10 MB

            // Submit Button
            .d-grid.mt-4
              = f.submit "Update Account", class: "btn btn-primary btn-lg"