.app-content
  .container.d-flex.align-items-center.justify-content-center
    .card.border.border-secondary.mx-auto.mt-5.shadow-lg(style="width: 95%;")
      .card-header
        = link_to export_pdf_reservist_path(@reservist, format: :pdf), class: "btn btn-sm btn-primary float-end d-flex align-items-center gap-1" do
          %i.material-icons.text-gray-300 download
          %span.d-none.d-md-inline Download Profile
        .d-flex.flex-column.align-items-center
          %h4.card-title.text-center.fs-8.fs-sm-3 RESERVIST PERSONNEL INFORMATION
          -# %h4.card-title.text-center.fs-8.fs-sm-3 DATA CAPTURED FORM

      .card-body
        .container.gap-3.d-flex.flex-column
          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Rank
                %input.form-control{ readonly: true, value: @reservist.rank }
            .col-6.col-md-3
              %div
                %label.label-distinct Last Name
                %input.form-control{ readonly: true, value: @reservist.last_name }
            .col-6.col-md-3
              %div
                %label.label-distinct First Name
                %input.form-control{ readonly: true, value: @reservist.first_name }
            .col-6.col-md-3
              %div
                %label.label-distinct Middle Name
                %input.form-control{ readonly: true, value: @reservist.middle_name }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Branch of Service
                %input.form-control{ readonly: true, value: @reservist.branch_of_service }
            .col-6.col-md-3
              %div
                %label.label-distinct AFPSN
                %input.form-control{ readonly: true, value: @reservist.afpsn }
            .col-6.col-md-2
              %div
                %label.label-distinct Primary AFSC
                %input.form-control{ readonly: true, value: @reservist.primary_afsc }
            .col-6.col-md-3
              %div
                %label.label-distinct Duty AFSC
                %input.form-control{ readonly: true, value: @reservist.duty_afsc }

          .row
            .col-6.col-md-6
              %div
                %label.label-distinct Other Skills
                %textarea.form-control{ readonly: true }= @reservist.other_skills

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Source of Enlistment
                %input.form-control{ readonly: true, value: @reservist.source_of_enlistment }
            .col-6.col-md-3
              %div
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: @reservist.soe_authority }
            .col-6.col-md-3
              %div
                %label.label-distinct Date of Enlistment
                %input.form-control{ readonly: true, value: @reservist.soe_date_of_enlistment }
            .col-6.col-md-3
              %div
                %label.label-distinct Initial Rank
                %input.form-control{ readonly: true, value: @reservist.soe_initial_rank }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Source of Commission
                %input.form-control{ readonly: true, value: @reservist.source_of_commission }
            .col-6.col-md-3
              %div
                %label.label-distinct SOC Authority
                %input.form-control{ readonly: true, value: @reservist.soc_authority }
            .col-6.col-md-3
              %div
                %label.label-distinct SOC Date of Enlistment
                %input.form-control{ readonly: true, value: @reservist.soc_date_of_enlistment }
            .col-6.col-md-3
              %div
                %label.label-distinct SOC Initial Rank
                %input.form-control{ readonly: true, value: @reservist.soc_initial_rank }

          .row
            .col-6.col-md-4
              %div
                %label.label-distinct Reservist Classification
                %input.form-control{ readonly: true, value: @reservist.reservist_classification }
            .col-6.col-md-4
              %div
                %label.label-distinct Classification Authority
                %input.form-control{ readonly: true, value: @reservist.classification_authority }
            .col-6.col-md-4
              %div
                %label.label-distinct Date of Classification
                %input.form-control{ readonly: true, value: @reservist.date_of_classification }

          .row
            .col-6.col-md-4
              %div
                %label.label-distinct Reserve Unit Assignment
                %input.form-control{ readonly: true, value: @reservist.reserve_unit_assignment }
            .col-6.col-md-4
              %div
                %label.label-distinct Date Assigned
                %input.form-control{ readonly: true, value: @reservist.date_assigned }
            .col-6.col-md-4
              %div
                %label.label-distinct Unit Capability
                %input.form-control{ readonly: true, value: @reservist.unit_capability }

          .row
            .col-6.col-md-6
              %div
                %label.label-distinct Present Designation
                %input.form-control{ readonly: true, value: @reservist.present_designation }
            .col-6.col-md-6
              %div
                %label.label-distinct Mobilization Center
                %input.form-control{ readonly: true, value: @reservist.mobilization_center }

          .row
            .col-md-12.pt-3
              %div
                %label.label-distinct Location
                %input.form-control{ readonly: true, value: @reservist.location }

          .row
            .col-6.col-md-6.pt-3
              %div
                %label.label-distinct Latitude
                %input.form-control{ readonly: true, value: @reservist.lat }
            .col-6.col-md-6.pt-3
              %div
                %label.label-distinct Longitude
                %input.form-control{ readonly: true, value: @reservist.long }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Street Address
                %input.form-control{ readonly: true, value: @reservist.street_address }
            .col-6.col-md-2
              %div
                %label.label-distinct City
                %input.form-control{ readonly: true, value: @reservist.city }
            .col-6.col-md-3
              %div
                %label.label-distinct Province
                %input.form-control{ readonly: true, value: @reservist.province }
            .col-6.col-md-2
              %div
                %label.label-distinct ZIP Code
                %input.form-control{ readonly: true, value: @reservist.zip_code }
            .col-6.col-md-2
              %div
                %label.label-distinct Region
                %input.form-control{ readonly: true, value: @reservist.region }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Date of Birth
                %input.form-control{ readonly: true, value: @reservist.date_of_birth }
            .col-6.col-md-2
              %div
                %label.label-distinct Age
                %input.form-control{ readonly: true, value: @reservist.age }
            .col-md-7
              %div
                %label.label-distinct Place of Birth
                %input.form-control{ readonly: true, value: @reservist.place_of_birth }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Email
                %input.form-control{ readonly: true, value: @reservist.email }
            .col-6.col-md-3
              %div
                %label.label-distinct Residence Tel
                %input.form-control{ readonly: true, value: @reservist.residence_tel }
            .col-6.col-md-3
              %div
                %label.label-distinct Office Tel
                %input.form-control{ readonly: true, value: @reservist.office_tel }
            .col-6.col-md-3
              %div
                %label.label-distinct Mobile Nr
                %input.form-control{ readonly: true, value: @reservist.mobile_nr }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Ethnic Group
                %input.form-control{ readonly: true, value: @reservist.ethnic_group }
            .col-6.col-md-3
              %div
                %label.label-distinct Sex
                %input.form-control{ readonly: true, value: @reservist.sex }
            .col-6.col-md-3
              %div
                %label.label-distinct Marital Status
                %input.form-control{ readonly: true, value: @reservist.marital_status }
            .col-6.col-md-3
              %div
                %label.label-distinct Religion
                %input.form-control{ readonly: true, value: @reservist.religion }

          .row
            .col-6.col-md-2
              %div
                %label.label-distinct Blood Type
                %input.form-control{ readonly: true, value: @reservist.blood_type }
            .col-6.col-md-2
              %div
                %label.label-distinct Eye Color
                %input.form-control{ readonly: true, value: @reservist.eye_color }
            .col-6.col-md-2
              %div
                %label.label-distinct Hair Color
                %input.form-control{ readonly: true, value: @reservist.hair_color }
            .col-6.col-md-3
              %div
                %label.label-distinct Complexion
                %input.form-control{ readonly: true, value: @reservist.complexion }
            .col-6.col-md-3
              %div
                %label.label-distinct Identifying Marks
                %input.form-control{ readonly: true, value: @reservist.identifying_marks }

          .row
            .col-6.col-md-3
              %div
                %label.label-distinct Height (cm)
                %input.form-control{ readonly: true, value: @reservist.height_cm }
            .col-6.col-md-3
              %div
                %label.label-distinct Weight (kg)
                %input.form-control{ readonly: true, value: @reservist.weight_kg }

          .row
            .col-6.col-md-2
              %div
                %label.label-distinct TIN
                %input.form-control{ readonly: true, value: @reservist.tin }
            .col-6.col-md-2
              %div
                %label.label-distinct SSS Number
                %input.form-control{ readonly: true, value: @reservist.sss_number }
            .col-6.col-md-2
              %div
                %label.label-distinct GSIS Number
                %input.form-control{ readonly: true, value: @reservist.gsis_number }
            .col-6.col-md-3
              %div
                %label.label-distinct PhilHealth Number
                %input.form-control{ readonly: true, value: @reservist.philhealth_number }
            .col-6.col-md-3
              %div
                %label.label-distinct Pag-IBIG Number
                %input.form-control{ readonly: true, value: @reservist.pagibig_number }

          .row
            .col-6.col-md-6
              %div
                %label.label-distinct Dialects Spoken
                %textarea.form-control{ readonly: true }= @reservist.dialects_spoken

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 STATEMENT OF SERVICE

          - (@reservist.service_assignments || []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Position
                %input.form-control{ readonly: true, value: item["position"] }
              .col-md-3
                %label.label-distinct Unit
                %input.form-control{ readonly: true, value: item["unit"] }
              .col-md-3
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: item["authority"] }
              .col-md-3
                %label.label-distinct From - To
                %input.form-control{ readonly: true, value: "#{item["from"]} - #{item["to"]}" }

          - (@reservist.service_rank_adjustments || []).each do |item|
            .row
              .col-md-4
                %label.label-distinct Rank
                %input.form-control{ readonly: true, value: item["rank"] }
              .col-md-4
                %label.label-distinct Effective Date
                %input.form-control{ readonly: true, value: item["effective_date"] }
              .col-md-4
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: item["authority"] }

          - (@reservist.active_service || []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Type
                %input.form-control{ readonly: true, value: item["type"] }
              .col-md-3
                %label.label-distinct Purpose
                %input.form-control{ readonly: true, value: item["purpose"] }
              .col-md-3
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: item["authority"] }
              .col-md-3
                %label.label-distinct From - To
                %input.form-control{ readonly: true, value: "#{item["from"]} - #{item["to"]}" }

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 EDUCATIONAL BACKGROUND

          - %i[basic_primary basic_secondary basic_tertiary basic_rotc advance_rotc pre_commission].each do |field|
            - jsonb_rows(@reservist.send(field), []).each do |item|
              .row
                .col-md-3
                  %label.label-distinct School
                  %input.form-control{ readonly: true, value: item["school"] }
                .col-md-3
                  %label.label-distinct From
                  %input.form-control{ readonly: true, value: item["from"] }
                .col-md-3
                  %label.label-distinct To
                  %input.form-control{ readonly: true, value: item["to"] }
                .col-md-3
                  %label.label-distinct Grade
                  %input.form-control{ readonly: true, value: item["grade"] }

          - jsonb_rows(@reservist.post_graduate, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Degree
                %input.form-control{ readonly: true, value: item["post_graduate"] }
              .col-md-3
                %label.label-distinct School
                %input.form-control{ readonly: true, value: item["school"] }
              .col-md-2
                %label.label-distinct From
                %input.form-control{ readonly: true, value: item["from"] }
              .col-md-2
                %label.label-distinct To
                %input.form-control{ readonly: true, value: item["to"] }
              .col-md-2
                %label.label-distinct Grade
                %input.form-control{ readonly: true, value: item["grade"] }

          - jsonb_rows(@reservist.board_eligibility, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct License Type
                %input.form-control{ readonly: true, value: item["license_type"] }
              .col-md-3
                %label.label-distinct Exam Date
                %input.form-control{ readonly: true, value: item["exam_date"] }
              .col-md-3
                %label.label-distinct License No
                %input.form-control{ readonly: true, value: item["license_nr"] }
              .col-md-3
                %label.label-distinct Rating
                %input.form-control{ readonly: true, value: item["board_rating"] }

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 MILITARY TRAINING

          - jsonb_rows(@reservist.military_schooling, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Courses
                %input.form-control{ readonly: true, value: item["courses"] }
              .col-md-3
                %label.label-distinct School
                %input.form-control{ readonly: true, value: item["school"] }
              .col-md-2
                %label.label-distinct From
                %input.form-control{ readonly: true, value: item["from"] }
              .col-md-2
                %label.label-distinct To
                %input.form-control{ readonly: true, value: item["to"] }
              .col-md-2
                %label.label-distinct Standing/Grade
                %input.form-control{ readonly: true, value: item["grade"] }
          - jsonb_rows(@reservist.military_training, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Courses
                %input.form-control{ readonly: true, value: item["courses"] }
              .col-md-3
                %label.label-distinct School
                %input.form-control{ readonly: true, value: item["school"] }
              .col-md-2
                %label.label-distinct From
                %input.form-control{ readonly: true, value: item["from"] }
              .col-md-2
                %label.label-distinct To
                %input.form-control{ readonly: true, value: item["to"] }
              .col-md-2
                %label.label-distinct Standing/Grade
                %input.form-control{ readonly: true, value: item["grade"] }

          - jsonb_rows(@reservist.seminar, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Courses
                %input.form-control{ readonly: true, value: item["courses"] }
              .col-md-3
                %label.label-distinct School
                %input.form-control{ readonly: true, value: item["school"] }
              .col-md-2
                %label.label-distinct From
                %input.form-control{ readonly: true, value: item["from"] }
              .col-md-2
                %label.label-distinct To
                %input.form-control{ readonly: true, value: item["to"] }
              .col-md-2
                %label.label-distinct Standing/Grade
                %input.form-control{ readonly: true, value: item["grade"] }

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 WORK HISTORY

          - jsonb_rows(@reservist.work_positions, []).each do |item|
            .row
              .col-md-3
                %label.label-distinct Position
                %input.form-control{ readonly: true, value: item["position"] }
              .col-md-3
                %label.label-distinct Company
                %input.form-control{ readonly: true, value: item["company"] }
              .col-md-3
                %label.label-distinct Address
                %input.form-control{ readonly: true, value: item["business_address"] }
              .col-md-3
                %label.label-distinct From - To
                %input.form-control{ readonly: true, value: "#{item["from"]} - #{item["to"]}" }

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 AWARDS & RECOGNITION

          - jsonb_rows(@reservist.military_awards, []).each do |item|
            .row
              .col-md-4
                %label.label-distinct Award Type
                %input.form-control{ readonly: true, value: item["award_type"] }
              .col-md-4
                %label.label-distinct Achievements
                %input.form-control{ readonly: true, value: item["achievements"] }
              .col-md-4
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: item["authority"] }

          - jsonb_rows(@reservist.other_awards, []).each do |item|
            .row
              .col-md-4
                %label.label-distinct Award Type
                %input.form-control{ readonly: true, value: item["award_type"] }
              .col-md-4
                %label.label-distinct Achievements
                %input.form-control{ readonly: true, value: item["achievements"] }
              .col-md-4
                %label.label-distinct Authority
                %input.form-control{ readonly: true, value: item["authority"] }

          - jsonb_rows(@reservist.commendations, []).each do |item|
            .row
              .col-md-6
                %label.label-distinct Date
                %input.form-control{ readonly: true, value: item["date"] }
              .col-md-6
                %label.label-distinct Given By
                %input.form-control{ readonly: true, value: item["given_by"] }

          - jsonb_rows(@reservist.certificates, []).each do |item|
            .row
              .col-md-6
                %label.label-distinct Date Awarded
                %input.form-control{ readonly: true, value: item["date_awarded"] }
              .col-md-6
                %label.label-distinct Given By
                %input.form-control{ readonly: true, value: item["given_by"] }

        %hr
        .container.gap-3.d-flex.flex-column

          %h5 DEPENDENTS

          - jsonb_rows(@reservist.dependents, []).each do |item|
            .row
              .col-md-4
                %label.label-distinct Name
                %input.form-control{ readonly: true, value: item["name"] }
              .col-md-4
                %label.label-distinct Relationship
                %input.form-control{ readonly: true, value: item["relationship"] }
              .col-md-4
                %label.label-distinct Birth Date
                %input.form-control{ readonly: true, value: item["birth_date"] }
        %hr
        .container.gap-3.d-flex.flex-column

          %h5 CONTACT PERSON

          - data = @reservist.contact_persons

          - if data.present?
            - item = data.is_a?(Array) ? data.first : data

            .row
              .col-md-3
                %label.label-distinct Name
                %input.form-control{ readonly: true, value: item["name"] }
              .col-md-3
                %label.label-distinct Address
                %input.form-control{ readonly: true, value: item["address"] }
              .col-md-3
                %label.label-distinct Relationship
                %input.form-control{ readonly: true, value: item["relationship"] }
              .col-md-3
                %label.label-distinct Contact Number
                %input.form-control{ readonly: true, value: item["contact_number"] }