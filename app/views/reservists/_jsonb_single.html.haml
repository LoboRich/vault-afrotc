-# locals: form, field_name, fields

.row
  .col-md-12
    %label= field_name.to_s.humanize

  - data = form.object.send(field_name).presence&.first || {}

  .row
    - fields.each do |field|
      .col-md-2.mb-2
        = text_field_tag "reservist[#{field_name}][][#{field}]",
          data[field.to_s],
          placeholder: field.to_s.humanize,
          class: "form-control"