%section.section
  .section-header.d-mobile-none
    .page-description.d-flex.align-items-center
      %h1.flex-grow-1
        Editing Reservist
    .section-header-breadcrumb
      .breadcrumb-item 
        = link_to 'Dashboard', '/'
      .breadcrumb-item
        @reservist

  .col-12.col-md-12.col-lg-12
    .card
      .card-body.p-0
        = form_with(model: @reservist,
          url: update_step_reservist_path(@reservist),
          method: :patch,
          data: { controller: "wizard" }) do |form|

          .wizard-container

            = render "reservists/wizard/steps", form: form

            = render "reservists/wizard/navigation"

- content_for(:page_title, 'Dashboard')
