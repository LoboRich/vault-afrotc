-# locals: form, field_name, fields, labels (optional)

- labels ||= {}

.row
  -# .col-md-12
  -#   %label= field_name.to_s.humanize

  - container_id = "#{field_name}-container"
  - add_btn_id = "add-#{field_name.to_s.dasherize}"
  - data = form.object.send(field_name) || []

  - data = [{}] if data.blank?

  %div{id: container_id}
    - data.each_with_index do |item, i|
      .row.jsonb-item.mb-1.position-relative
        - fields.each do |field|
          .col-md-3.mb-2
            = text_field_tag "reservist[#{field_name}][][#{field}]",
              item[field.to_s],
              placeholder: (labels[field] || field.to_s.humanize),
              class: "form-control"

        %button.btn.btn-danger.remove-item.position-absolute{
          type: "button",
          style: "top: -10px; right: -10px; width: 30px; height: 30px; border-radius: 50%; padding: 0;"
        }
          ✕

  .mt-2.mb-4
    %button.btn.btn-sm.btn-primary{ type: "button", id: add_btn_id, data: { container: container_id, field: field_name, fields: fields.join(",") } }
      Add #{field_name.to_s.singularize.humanize}