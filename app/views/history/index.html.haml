
.app-content
  .content-wrapper
    .container
      .card
        .card-header
          %div.d-flex.align-items-center
            %h4.card-title
              Logs
            %div.ms-auto.d-flex.gap-2.justify-content-end
              %a.d-none.d-sm-inline-block.btn.btn-sm.btn-success.shadow-sm{:href => "#"}
                %i.material-icons.me-1 download
                Download

        .card-body
          .datatable-container
            .table-responsive.datatable-container
              %table#logs-table.table.table-striped.table-bordered.table-hover.table-sm.datatable
                %thead.bg-light
                  %tr
                    %th User
                    %th Action
                    %th Record
                    %th Changes
                    %th Timestamp
                %tbody
                  - @histories.each do |history|
                    %tr.odd{ role: "row" }
                      %td= link_to history.user[:fullname], "/#{history.record_id}/#{history.user[:user_id]}"
                      %td= history.action
                      %td= link_to "Record link", "/#{history.record_id}/#{history.record_id}"
                      %td= history.changes
                      %td= history.timestamp.strftime("%Y-%m-%d %H:%M")                    
                      




